---
import type { CollectionEntry } from 'astro:content';
import { href, t } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
// fallback = true: título e resumo em PT dentro de uma página EN ou DE; o atributo lang faz o leitor de tela trocar a pronúncia.
interface Props { entry: CollectionEntry<'noticias'>; slug: string; locale: Locale; fallback?: boolean }
const { entry, slug, locale, fallback = false } = Astro.props;
const textLang = fallback ? 'pt-BR' : undefined;
const date = entry.data.data.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="card">
  <p class="meta"><time datetime={entry.data.data.toISOString()}>{date}</time></p>
  <h3><a href={href(locale, `noticias/${slug}`)} lang={textLang}>{entry.data.titulo}</a></h3>
  <p lang={textLang}>{entry.data.resumo}</p>
  <span class="sr-only">{t(locale)('news.readmore')}</span>
</article>
<style>
  .card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-6); }
  .meta { font-size: var(--text-sm); color: var(--color-ink-muted); margin: 0; }
  h3 { font-size: var(--text-lg); margin-block: var(--space-2); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
