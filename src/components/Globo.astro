---
// Globo da página inicial: três modos (países, entidades, pings).
// Os dados vêm de src/data/globo/*.json, cada item com a sua fonte.
// O globo em si só é carregado quando a seção aparece na tela (ver o script).
import type { Locale } from '@/i18n/ui';
import { t } from '@/i18n/utils';
import paisesJson from '@/data/globo/paises.json';
import entidadesJson from '@/data/globo/entidades.json';
import pingsJson from '@/data/globo/pings-exemplo.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const bcp = locale === 'pt' ? 'pt-BR' : locale;
const nomePais = new Intl.DisplayNames([bcp], { type: 'region' });
const numero = new Intl.NumberFormat(bcp);
const pais = (iso: string) => nomePais.of(iso) ?? iso;

const paises = [...paisesJson.paises]
  .sort((a, b) => b.falantes - a.falantes)
  .map((p) => ({ ...p, nome: pais(p.iso2) + (p.iso2 === 'IT' ? ' (Tirol do Sul)' : '') }));

const entidades = [...entidadesJson.entidades]
  .map((e) => ({
    ...e,
    nomePais: pais(e.pais),
    tipoRotulo: tr(e.tipo === 'universidade' ? 'globe.type.universidade' : 'globe.type.associacao'),
  }))
  .sort((a, b) => a.nomePais.localeCompare(b.nomePais, bcp) || a.nome.localeCompare(b.nome, bcp));

const pings = pingsJson.pings;

// Ranking de países (modo "países"): alternativa por botões para quem não usa o mouse no globo.
const compacto = new Intl.NumberFormat(bcp, { notation: 'compact', maximumFractionDigits: 1 });
const fMax = Math.max(...paises.map((p) => p.falantes));
const fMin = Math.min(...paises.map((p) => p.falantes));
const larguraBarra = (v: number) => 12 + 88 * ((Math.log10(v) - Math.log10(fMin)) / (Math.log10(fMax) - Math.log10(fMin)));

const dados = {
  locale: bcp,
  paises,
  entidades,
  pings,
  rotulos: {
    falantes: tr('globe.speakers'),
    fonte: tr('globe.source'),
    aprox: tr('globe.approx'),
    anonimo: tr('globe.ping.anon'),
    publico: tr('globe.ping.public'),
    privado: tr('globe.ping.private'),
    exemplo: tr('globe.ping.example'),
    universidade: tr('globe.type.universidade'),
    associacao: tr('globe.type.associacao'),
    compactoMin: compacto.format(fMin),
    compactoMax: compacto.format(fMax),
  },
};
const modos = [
  { id: 'paises', rotulo: tr('globe.mode.paises'), legenda: tr('globe.legend.paises') },
  { id: 'entidades', rotulo: tr('globe.mode.entidades'), legenda: tr('globe.legend.entidades') },
  { id: 'pings', rotulo: tr('globe.mode.pings'), legenda: tr('globe.legend.pings') },
];
---
<section class="globo" aria-labelledby="globo-titulo" data-globo>
  <h2 id="globo-titulo">{tr('globe.title')}</h2>
  <p class="lead">{tr('globe.lead')}</p>

  <div class="barra">
    <div role="tablist" aria-label={tr('globe.modes')} class="modos">
      {modos.map((m, i) => (
        <button type="button" role="tab" id={`globo-aba-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="globo-palco" tabindex={i === 0 ? 0 : -1} data-modo={m.id} data-legenda={m.legenda}>{m.rotulo}</button>
      ))}
    </div>
    <button type="button" class="girar" data-girar data-pause={tr('globe.pause')} data-play={tr('globe.play')}><svg class="icone" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false" data-icone><rect x="3.5" y="3" width="3" height="10" rx="1"/><rect x="9.5" y="3" width="3" height="10" rx="1"/></svg><span data-girar-rotulo>{tr('globe.pause')}</span></button>
  </div>

  <div class="palco" id="globo-palco" role="tabpanel" aria-labelledby="globo-aba-paises">
    <div class="tela" data-tela aria-hidden="true">
      <p class="carregando" data-carregando>{tr('globe.loading')}</p>
    </div>
    <aside class="lateral">
      <p class="legenda" data-legenda aria-live="polite">{modos[0].legenda}</p>
      <div class="chave" data-chave aria-hidden="true"></div>
      <ul class="ranking" data-ranking>
        {paises.map((p) => (
          <li>
            <button type="button" class="pais" data-iso={p.iso3166num}>
              <span class="pais-nome">{p.nome}</span>
              <span class="pais-barra" aria-hidden="true"><i style={`width:${larguraBarra(p.falantes).toFixed(0)}%`}></i></span>
              <span class="pais-valor">{compacto.format(p.falantes)}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="detalhe" data-detalhe aria-live="polite"></div>
      <p class="breve">
        <button type="button" class="btn-ping" disabled>{tr('globe.ping.add')}</button>
        <span>{tr('globe.ping.soon')}</span>
      </p>
    </aside>
  </div>

  <p class="aviso" data-nogl hidden>{tr('globe.nogl')}</p>

  <details class="texto" data-texto data-pagefind-ignore="all">
    <summary>{tr('globe.alt')}</summary>

    <div data-painel="paises">
      <table>
        <caption class="sr-only">{tr('globe.mode.paises')}</caption>
        <thead><tr><th scope="col">{tr('globe.col.country')}</th><th scope="col" class="num">{tr('globe.col.speakers')}</th></tr></thead>
        <tbody>
          {paises.map((p) => (<tr><th scope="row">{p.nome}</th><td class="num">{numero.format(p.falantes)}</td></tr>))}
        </tbody>
      </table>
      <p class="nota">{tr('globe.note.countries')} {tr('globe.source')}: <a href={paisesJson.fonteUrl} rel="noopener">{paisesJson.fonte}</a>.</p>
    </div>

    <div data-painel="entidades" hidden>
      <table>
        <caption class="sr-only">{tr('globe.mode.entidades')}</caption>
        <thead><tr><th scope="col">{tr('globe.col.name')}</th><th scope="col">{tr('globe.col.type')}</th><th scope="col">{tr('globe.col.city')}</th><th scope="col">{tr('globe.col.country')}</th></tr></thead>
        <tbody>
          {entidades.map((e) => (
            <tr>
              <th scope="row"><a href={e.fonteUrl} rel="noopener">{e.nome}</a></th>
              <td>{e.tipoRotulo}</td><td>{e.cidade}</td><td>{e.nomePais}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div data-painel="pings" hidden>
      <table>
        <caption class="sr-only">{tr('globe.mode.pings')}</caption>
        <thead><tr><th scope="col">{tr('globe.col.who')}</th><th scope="col">{tr('globe.col.where')}</th></tr></thead>
        <tbody>
          {pings.map((p) => (
            <tr>
              <th scope="row">{p.publico && p.nome ? `${p.nome}${p.instituicao ? `, ${p.instituicao}` : ''}` : tr('globe.ping.anon')}</th>
              <td>{p.lat.toFixed(1)}, {p.lng.toFixed(1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="nota">{tr('globe.ping.example')}.</p>
    </div>
  </details>

  <script type="application/json" id="globo-dados" set:html={JSON.stringify(dados)} />
</section>

<script>
  import type { GlobeInstance } from 'globe.gl';

  type Pais = { iso2: string; iso3166num: string; falantes: number; nome: string; nota: string };
  type Entidade = { id: string; nome: string; tipo: string; cidade: string; nomePais: string; tipoRotulo: string; lat: number; lng: number; precisao: string; fonte: string; fonteUrl: string };
  type Ping = { id: string; lat: number; lng: number; publico: boolean; nome: string | null; instituicao: string | null; papel: string | null; mensagem: string | null; exemplo: boolean };
  type Dados = { locale: string; paises: Pais[]; entidades: Entidade[]; pings: Ping[]; rotulos: Record<string, string> };
  type Modo = 'paises' | 'entidades' | 'pings';

  const raiz = document.querySelector<HTMLElement>('[data-globo]');
  const ilha = document.getElementById('globo-dados');
  if (raiz && ilha) iniciar(raiz, JSON.parse(ilha.textContent ?? '{}') as Dados);

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  function iniciar(raiz: HTMLElement, dados: Dados) {
    const tela = raiz.querySelector<HTMLElement>('[data-tela]')!;
    const carregando = raiz.querySelector<HTMLElement>('[data-carregando]')!;
    const legenda = raiz.querySelector<HTMLElement>('[data-legenda]:not(button)')!;
    const detalhe = raiz.querySelector<HTMLElement>('[data-detalhe]')!;
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const botaoGirar = raiz.querySelector<HTMLButtonElement>('[data-girar]')!;
    const aviso = raiz.querySelector<HTMLElement>('[data-nogl]')!;
    const texto = raiz.querySelector<HTMLDetailsElement>('[data-texto]')!;
    const painel = raiz.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)');
    const toque = matchMedia('(pointer: coarse)').matches;
    const estreito = matchMedia('(max-width: 40rem)').matches;
    const numero = new Intl.NumberFormat(dados.locale);
    const cor = lerCores();

    let modo: Modo = 'paises';
    let globo: GlobeInstance | null = null;
    let pausadoPeloUsuario = reduzido.matches;
    let sobAPonteiro = false;
    let features: any[] = [];
    let passando: any = null;
    let selecionado: any = null;

    const falantes = new Map(dados.paises.map((p) => [p.iso3166num, p]));
    const maxF = Math.max(...dados.paises.map((p) => p.falantes));
    const minF = Math.min(...dados.paises.map((p) => p.falantes));
    const escala = (v: number) => (Math.log10(v) - Math.log10(minF)) / (Math.log10(maxF) - Math.log10(minF));

    function lerCores() {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      return { tinta: v('--color-ink'), mudo: v('--color-ink-muted'), linha: v('--color-line'), papel: v('--color-paper'), superficie: v('--color-surface'), acento: v('--color-accent') };
    }
    function rgb(hex: string): [number, number, number] {
      const h = hex.replace('#', '');
      const n = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
      return [parseInt(n.slice(0, 2), 16) || 0, parseInt(n.slice(2, 4), 16) || 0, parseInt(n.slice(4, 6), 16) || 0];
    }
    const [ar, ag, ab] = rgb(cor.acento);
    const [tr_, tg, tb] = rgb(cor.tinta);
    const chave = raiz.querySelector<HTMLElement>('[data-chave]')!;
    const ranking = raiz.querySelector<HTMLElement>('[data-ranking]')!;
    const codigo = (f: any) => String(f.id).padStart(3, '0');

    // HTML do cartão (dica ao passar o mouse e painel ao clicar).
    function cartaoPais(p: Pais) {
      return `<div class="gl-tip"><strong>${esc(p.nome)}</strong><span>${numero.format(p.falantes)} ${esc(dados.rotulos.falantes)}</span></div>`;
    }
    function cartaoEntidade(e: Entidade) {
      const onde = [e.cidade, e.nomePais].filter(Boolean).join(', ');
      return `<div class="gl-tip"><strong>${esc(e.nome)}</strong><span>${esc(e.tipoRotulo)} · ${esc(onde)}</span>${e.precisao === 'pais' ? `<span>${esc(dados.rotulos.aprox)}</span>` : ''}<span>${esc(dados.rotulos.fonte)}: ${esc(e.fonte)}</span></div>`;
    }
    function cartaoPing(p: Ping) {
      if (!p.publico || !p.nome) {
        return `<div class="gl-tip"><strong>${esc(dados.rotulos.anonimo)}</strong><span>${esc(dados.rotulos.privado)}</span><span>${esc(dados.rotulos.exemplo)}</span></div>`;
      }
      const linhas = [p.papel, p.instituicao].filter(Boolean).map((l) => `<span>${esc(l as string)}</span>`).join('');
      return `<div class="gl-tip"><strong>${esc(p.nome)}</strong>${linhas}${p.mensagem ? `<span>${esc(p.mensagem)}</span>` : ''}<span>${esc(dados.rotulos.publico)} · ${esc(dados.rotulos.exemplo)}</span></div>`;
    }
    function mostrar(html: string) { detalhe.innerHTML = html; }

    function canvasDe() { return tela.querySelector<HTMLCanvasElement>('canvas'); }

    // Cor de cada ponto de terra: países de língua alemã em tom de acento (mais forte = mais falantes);
    // o resto, em tinta bem suave, para a terra aparecer sem competir.
    function corTerra(f: any) {
      const p = modo === 'paises' ? falantes.get(codigo(f)) : undefined;
      if (!p) return `rgba(${tr_},${tg},${tb},${modo === 'paises' ? 0.2 : 0.28})`;
      if (f === passando || f === selecionado) return cor.acento;
      return `rgba(${ar},${ag},${ab},${(0.4 + 0.6 * escala(p.falantes)).toFixed(2)})`;
    }

    // Centro aproximado do maior pedaço do país, para girar o globo até ele.
    function centro(f: any): { lat: number; lng: number } {
      const polis: number[][][][] = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : f.geometry.coordinates;
      const maior = polis.reduce((a, b) => (b[0].length > a[0].length ? b : a));
      let x0 = 180, x1 = -180, y0 = 90, y1 = -90;
      for (const [x, y] of maior[0]) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }
      return { lat: (y0 + y1) / 2, lng: (x0 + x1) / 2 };
    }

    function escolher(p: Pais, f: any, girarAte: boolean) {
      selecionado = f;
      mostrar(cartaoPais(p));
      globo?.hexPolygonColor(corTerra);
      for (const b of ranking.querySelectorAll<HTMLElement>('.pais')) b.classList.toggle('ativo', b.dataset.iso === p.iso3166num);
      if (girarAte && globo) {
        const c = centro(f);
        globo.pointOfView({ ...c, altitude: estreito ? 1.7 : 2 }, reduzido.matches ? 0 : 900);
        pausadoPeloUsuario = true; rotuloGirar(); girar();
      }
    }

    // Legenda visual do modo atual, ao lado do texto da legenda.
    function montarChave() {
      const bolinha = (c: string, r: string) => `<li><i class="ponto" style="background:${c}"></i>${esc(r)}</li>`;
      if (modo === 'paises') {
        chave.innerHTML = `<div class="escala"><span class="escala-barra" style="background:linear-gradient(to right, rgba(${ar},${ag},${ab},0.4), rgb(${ar},${ag},${ab}))"></span><span class="escala-rot"><span>${esc(dados.rotulos.compactoMin)}</span><span>${esc(dados.rotulos.compactoMax)}</span></span></div>`;
      } else if (modo === 'entidades') {
        chave.innerHTML = `<ul class="pontos">${bolinha(cor.acento, dados.rotulos.universidade)}${bolinha(cor.tinta, dados.rotulos.associacao)}</ul>`;
      } else {
        chave.innerHTML = `<ul class="pontos">${bolinha(cor.acento, dados.rotulos.publico)}${bolinha(cor.mudo, dados.rotulos.anonimo)}</ul>`;
      }
    }

    function aplicarModo() {
      if (!globo) return;
      const g = globo;
      // Terra em pontos (hexágonos desenhados como círculos), colorida por país.
      g.hexPolygonsData(features)
        .hexPolygonColor(corTerra)
        .hexPolygonAltitude((f: any) => {
          const p = modo === 'paises' ? falantes.get(codigo(f)) : undefined;
          return p ? 0.008 + 0.03 * escala(p.falantes) : 0.004;
        })
        .hexPolygonLabel((f: any) => {
          const p = modo === 'paises' ? falantes.get(codigo(f)) : undefined;
          return p ? cartaoPais(p) : '';
        })
        .onHexPolygonHover((f: any) => {
          const p = f && modo === 'paises' ? falantes.get(codigo(f)) : undefined;
          passando = p ? f : null;
          canvasDe()?.style.setProperty('cursor', p ? 'pointer' : '');
          g.hexPolygonColor(corTerra);
        })
        .onHexPolygonClick((f: any) => {
          const p = modo === 'paises' ? falantes.get(codigo(f)) : undefined;
          if (p) escolher(p, f, false);
        });

      if (modo === 'entidades') {
        g.pointsData(dados.entidades)
          .pointLat('lat').pointLng('lng')
          .pointColor((d: any) => (d.tipo === 'universidade' ? cor.acento : cor.tinta))
          .pointAltitude(0.03).pointRadius(toque ? 0.7 : 0.32)
          .pointLabel((d: any) => cartaoEntidade(d))
          .onPointClick((d: any) => mostrar(cartaoEntidade(d)));
      } else if (modo === 'pings') {
        g.pointsData(dados.pings)
          .pointLat('lat').pointLng('lng')
          .pointColor((d: any) => (d.publico ? cor.acento : cor.mudo))
          .pointAltitude(0.03).pointRadius(toque ? 0.8 : 0.4)
          .pointLabel((d: any) => cartaoPing(d))
          .onPointClick((d: any) => mostrar(cartaoPing(d)));
      } else {
        g.pointsData([]);
      }

      if (modo === 'pings' && !reduzido.matches) {
        g.ringsData(dados.pings.filter((p) => p.publico))
          .ringLat('lat').ringLng('lng')
          .ringColor(() => (t: number) => `rgba(${ar},${ag},${ab},${(1 - t).toFixed(2)})`)
          .ringMaxRadius(3).ringPropagationSpeed(1.2).ringRepeatPeriod(2400);
      } else {
        g.ringsData([]);
      }
    }

    function girar() {
      if (!globo) return;
      const c = globo.controls() as any;
      // Com prefers-reduced-motion o globo começa parado (pausadoPeloUsuario = true),
      // mas se a pessoa apertar "Girar o globo" a escolha dela vale.
      c.autoRotate = !pausadoPeloUsuario && !sobAPonteiro;
    }

    // No celular as abas ficam numa linha com rolagem horizontal: traz a ativa para a vista
    // sem mexer na rolagem vertical da página.
    function mostrarAba(a: HTMLElement) {
      const lista = a.parentElement!;
      if (lista.scrollWidth <= lista.clientWidth) return;
      const ra = a.getBoundingClientRect();
      const rl = lista.getBoundingClientRect();
      const delta = ra.left < rl.left ? ra.left - rl.left - 8 : ra.right > rl.right ? ra.right - rl.right + 8 : 0;
      if (delta) lista.scrollBy({ left: delta, behavior: reduzido.matches ? 'auto' : 'smooth' });
    }

    function trocar(novo: Modo, foco = false) {
      modo = novo;
      for (const a of abas) {
        const ativa = a.dataset.modo === novo;
        a.setAttribute('aria-selected', String(ativa));
        a.tabIndex = ativa ? 0 : -1;
        if (ativa) {
          legenda.textContent = a.dataset.legenda ?? '';
          painel.setAttribute('aria-labelledby', a.id);
          if (foco) a.focus({ preventScroll: true });
          mostrarAba(a);
        }
      }
      for (const p of raiz.querySelectorAll<HTMLElement>('[data-painel]')) p.hidden = p.dataset.painel !== novo;
      selecionado = null; passando = null;
      ranking.hidden = novo !== 'paises';
      for (const b of ranking.querySelectorAll<HTMLElement>('.pais')) b.classList.remove('ativo');
      mostrar('');
      montarChave();
      aplicarModo();
    }

    abas.forEach((a, i) => {
      a.addEventListener('click', () => trocar(a.dataset.modo as Modo));
      a.addEventListener('keydown', (e) => {
        const passo = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          trocar(abas[e.key === 'Home' ? 0 : abas.length - 1].dataset.modo as Modo, true);
        } else if (passo) {
          e.preventDefault();
          trocar(abas[(i + passo + abas.length) % abas.length].dataset.modo as Modo, true);
        }
      });
    });

    function rotuloGirar() {
      botaoGirar.querySelector('[data-girar-rotulo]')!.textContent = pausadoPeloUsuario ? botaoGirar.dataset.play! : botaoGirar.dataset.pause!;
      botaoGirar.querySelector('[data-icone]')!.innerHTML = pausadoPeloUsuario
        ? '<path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/>'
        : '<rect x="3.5" y="3" width="3" height="10" rx="1"/><rect x="9.5" y="3" width="3" height="10" rx="1"/>';
    }
    botaoGirar.addEventListener('click', () => { pausadoPeloUsuario = !pausadoPeloUsuario; rotuloGirar(); girar(); });

    ranking.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.pais');
      if (!b || !globo) return;
      const f = features.find((x) => codigo(x) === b.dataset.iso);
      const p = falantes.get(b.dataset.iso ?? '');
      if (f && p) escolher(p, f, true);
    });

    async function carregar() {
      try {
        const [{ default: Globe }, topo, { feature }] = await Promise.all([
          import('globe.gl'),
          import('world-atlas/countries-110m.json'),
          import('topojson-client'),
        ]);
        const mundo: any = (topo as any).default ?? topo;
        features = (feature(mundo, mundo.objects.countries) as any).features;

        const g = new (Globe as any)(tela, { animateIn: !reduzido.matches }) as GlobeInstance;
        globo = g;
        g.backgroundColor('rgba(0,0,0,0)')
          .showAtmosphere(false)
          .globeImageUrl(null as any)
          .hexPolygonResolution(3)
          .hexPolygonMargin(0.3)
          .hexPolygonUseDots(true)
          .hexPolygonsTransitionDuration(reduzido.matches ? 0 : 400);
        const mat = g.globeMaterial() as any;
        // Esfera quase transparente, só um véu: o globo se mistura ao fundo da página e os pontos fazem o desenho.
        mat.color.set('#000000');
        mat.emissive.set(cor.linha);
        mat.emissiveIntensity = 1;
        mat.transparent = true;
        mat.opacity = 0.32;
        mat.shininess = 0;
        mat.specular?.set('#000000');
        const c = g.controls() as any;
        c.autoRotateSpeed = 0.6;
        c.enablePan = false;
        c.minDistance = 180;
        c.maxDistance = 420;
        g.pointOfView({ lat: -15, lng: -50, altitude: estreito ? 1.7 : 2.2 }, 0);

        const medir = () => { g.width(tela.clientWidth).height(tela.clientHeight); };
        medir();
        new ResizeObserver(medir).observe(tela);

        // A roda do mouse sobre o globo rola a página. Com Ctrl ou Cmd (e na pinça do trackpad,
        // que chega como wheel com ctrlKey) o evento segue para os controles e aproxima o globo.
        tela.addEventListener('wheel', (e) => { if (!e.ctrlKey && !e.metaKey) e.stopPropagation(); }, { capture: true });
        tela.addEventListener('pointerenter', () => { sobAPonteiro = true; girar(); });
        tela.addEventListener('pointerleave', () => { sobAPonteiro = false; girar(); });
        reduzido.addEventListener('change', () => { if (reduzido.matches) pausadoPeloUsuario = true; rotuloGirar(); aplicarModo(); girar(); });

        carregando.remove();
        tela.setAttribute('data-pronto', '');
        tela.removeAttribute('aria-hidden');
        trocar(modo);
        girar();
      } catch (erro) {
        console.warn('Globo indisponível', erro);
        carregando.remove();
        aviso.hidden = false;
        texto.open = true;
      }
    }

    // Só baixa o Three.js quando a seção está perto de aparecer.
    const io = new IntersectionObserver((entradas) => {
      if (entradas.some((e) => e.isIntersecting)) { io.disconnect(); carregar(); }
    }, { rootMargin: '300px' });
    io.observe(raiz);
    rotuloGirar();
  }
</script>

