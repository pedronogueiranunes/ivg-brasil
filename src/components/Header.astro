---
import { getLocale, t, href } from '@/i18n/utils';
import { sections } from '@/i18n/nav';
import LanguageSwitcher from './LanguageSwitcher.astro';
const locale = getLocale(Astro.url);
const tr = t(locale);
const linkBusca = href(locale, 'busca');
const naBusca = Astro.url.pathname.replace(/\/?$/, '/') === linkBusca;
---
<header class="header">
  <a class="skip-link" href="#conteudo">{tr('nav.skip')}</a>
  <div class="container bar">
    <a class="brand" href={href(locale)}>{tr('site.name')}</a>
    <nav aria-label={tr('nav.menu')}>
      <ul class="menu">
        {sections.map((s) => <li><a href={href(locale, s.slug)}>{tr(s.label)}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="busca" href={linkBusca} aria-current={naBusca ? 'page' : undefined}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="m13 13 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        <span>{tr('search.link')}</span>
      </a>
      <LanguageSwitcher />
      <a class="cta" href={href(locale, 'filiacao')}>{tr('cta.filiar')}</a>
    </div>
  </div>
</header>
<style>
  .header { background: var(--color-surface); border-bottom: 1px solid var(--color-line); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding-block: var(--space-3); }
  .brand { font-weight: 700; font-size: var(--text-lg); text-decoration: none; }
  .menu { display: flex; flex-wrap: wrap; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .menu a { text-decoration: none; }
  .menu a:hover { text-decoration: underline; }
  .actions { margin-left: auto; display: flex; gap: var(--space-3); align-items: center; }
  .busca { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 2.75rem; padding-inline: var(--space-2); text-decoration: none; font-size: var(--text-sm); border-radius: var(--radius); }
  .busca:hover span { text-decoration: underline; }
  .busca[aria-current='page'] span { font-weight: 700; text-decoration: underline; }
  .cta { background: var(--color-accent); color: var(--color-accent-ink); padding: var(--space-2) var(--space-4); border-radius: var(--radius); text-decoration: none; font-weight: 600; }
</style>
