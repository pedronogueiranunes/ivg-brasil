---
import Base from '@/layouts/Base.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { getLocale, t } from '@/i18n/utils';
import { localeParams } from '@/i18n/paths';
export function getStaticPaths() { return localeParams; }
const locale = getLocale(Astro.url);
const tr = t(locale);
const news = (await getCollection('noticias', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
---
<Base title={tr('nav.noticias')}>
  <h1>{tr('nav.noticias')}</h1>
  <div class="list">{news.map((entry) => <NewsCard entry={entry} locale={locale} />)}</div>
</Base>
<style>
  .list { display: grid; gap: var(--space-4); }
</style>
