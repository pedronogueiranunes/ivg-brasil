---
import Base from '@/layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { locales, defaultLocale } from '@/i18n/ui';
import { getLocale, t } from '@/i18n/utils';
export async function getStaticPaths() {
  const news = await getCollection('noticias', ({ data }) => !data.rascunho);
  return locales.flatMap((l) => news.map((entry) => ({
    params: { locale: l === defaultLocale ? undefined : l, slug: entry.id.replace(/^pt\//, '') },
    props: { entry },
  })));
}
const { entry } = Astro.props;
const locale = getLocale(Astro.url);
const { Content } = await render(entry);
const date = entry.data.data.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.titulo} description={entry.data.resumo}>
  <article class="post">
    {locale !== 'pt' && <p class="notice" role="note">{t(locale)('lang.missing')}</p>}
    <p class="meta"><time datetime={entry.data.data.toISOString()}>{date}</time>{entry.data.autor && ` · ${entry.data.autor}`}</p>
    <h1>{entry.data.titulo}</h1>
    <Content />
  </article>
</Base>
<style>
  .post { max-width: 42rem; padding-block: var(--space-8); }
  .meta { color: var(--color-ink-muted); font-size: var(--text-sm); }
  .notice { background: var(--color-surface); border-left: 4px solid var(--color-accent); padding: var(--space-3) var(--space-4); }
</style>
